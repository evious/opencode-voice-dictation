{
  "name": "opencode-voice-dictation",
  "version": "0.8.1",
  "description": "Offline voice dictation and read-aloud for OpenCode Desktop and TUI on Windows and Linux",
  "license": "MIT",
  "author": "Fran Carlos <francarlos803@gmail.com>",
  "homepage": "https://github.com/evious/opencode-voice-dictation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evious/opencode-voice-dictation.git"
  },
  "bugs": {
    "url": "https://github.com/evious/opencode-voice-dictation/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "terminal",
    "voice",
    "dictation",
    "speech-to-text",
    "text-to-speech",
    "windows",
    "linux",
    "whisper.cpp",
    "offline"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dependencies": {
    "@opencode/plugin": "2.2.6",
    "msedge-tts": "^2.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "node test/speech-text.cjs && node test/tui.cjs && node test/smoke.cjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@opencode/theme": "^2.2.6",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@types/node": "^24.0.0",
    "effect": "4.1.0",
    "solid-js": "^1.9.17",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
